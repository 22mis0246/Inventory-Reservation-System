# ─── Postgres (Neon recommended) ─────────────────────────────────────────────
# Pooled URL — use for the running app (Prisma queries)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Direct URL — use for migrations only (Neon: copy "direct" connection string)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ─── Upstash Redis (Stage 9 — idempotency; optional until then) ─────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Reservation settings ───────────────────────────────────────────────────
# How long a checkout hold lasts before auto-release (minutes)
RESERVATION_TTL_MINUTES=10

# ─── Vercel Cron (Stage 6) ──────────────────────────────────────────────────
# Random secret — Vercel sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me-to-a-long-random-string"

# ─── App URL (local dev / production) ───────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
