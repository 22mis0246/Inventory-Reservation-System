# Supabase + Prisma (copy from Dashboard → Connect → ORMs → Prisma)
# Use .env for Prisma CLI (migrate/seed). Next.js also reads .env.local if you prefer.

# Transaction pooler — port 6543 + pgbouncer (app queries)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler — port 5432 on pooler host (migrations)
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# If @ # % / appear in password, URL-encode them (e.g. @ → %40)

RESERVATION_TTL_MINUTES=10
CRON_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional until Stage 9
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
